#!/bin/sh
set -eu

# The portable archive has no platform-specific apphost. Keep the same applet
# names by translating the invoked symlink to a command before launching .NET.
cli_path=$0
while [ -L "$cli_path" ]; do
    cli_directory=$(CDPATH= cd -- "$(dirname -- "$cli_path")" && pwd)
    cli_target=$(readlink -- "$cli_path")
    case "$cli_target" in
        /*) cli_path=$cli_target ;;
        *) cli_path=$cli_directory/$cli_target ;;
    esac
done
cli_directory=$(CDPATH= cd -- "$(dirname -- "$cli_path")" && pwd)
case "${0##*/}" in
    sdw-migrate) set -- migrate "$@" ;;
esac
exec dotnet "$cli_directory/sdw-cli.dll" "$@"
